-- ===== Auto Farm 逻辑 =====
local function getCar()
	local plr = Players.LocalPlayer
	local chr = plr.Character
	if not chr then return nil, nil end
	local hum = chr:FindFirstChildOfClass("Humanoid")
	if not hum or not hum.SeatPart then return nil, chr end
	local car = hum.SeatPart.Parent
	return car, chr
end

local function runFarm()
	local car, chr = getCar()
	if not car or not chr then
		warn("[AutoFarm] 未检测到载具，请先坐入驾驶座")
		running = false
		toggleBtn.Text = "Auto Farm: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
		return
	end

	-- 设置 PrimaryPart
	if car:FindFirstChild("Body") and car.Body:FindFirstChild("#Weight") then
		car.PrimaryPart = car.Body["#Weight"]
	else
		car.PrimaryPart = car:FindFirstChildWhichIsA("BasePart")
	end
	if not car.PrimaryPart then
		warn("[AutoFarm] 无法确定车辆 PrimaryPart")
		running = false
		toggleBtn.Text = "Auto Farm: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
		return
	end

	while running do
		task.wait()
		local car, chr = getCar()
		if not car or not chr or not car.PrimaryPart then
			running = false
			break
		end

		if not workspace:FindFirstChild("justanormalpart") then
			local new = Instance.new("Part")
			new.Name = "justanormalpart"
			new.Anchored = true
			new.CanCollide = false
			new.Transparency = 1
			new.Size = Vector3.new(10000, 10, 10000)
			new.Position = chr.HumanoidRootPart.Position + Vector3.new(0, 5000, 0)
			new.Parent = workspace
		end

		car.PrimaryPart.Velocity = car.PrimaryPart.CFrame.LookVector * speed
		task.wait(0.3)

		local platform = workspace:FindFirstChild("justanormalpart")
		if platform then
			car:PivotTo(platform.CFrame + Vector3.new(0, 7, 0))
		end
	end

	-- 关闭时清理
	if not running then
		toggleBtn.Text = "Auto Farm: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
		local platform = workspace:FindFirstChild("justanormalpart")
		if platform then platform:Destroy() end
	end
end

toggleBtn.MouseButton1Click:Connect(function()
	running = not running
	if running then
		toggleBtn.Text = "Auto Farm: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 70)
		task.spawn(runFarm)
	else
		toggleBtn.Text = "Auto Farm: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 68)
	end
end)
