local ShiftLockScreenGui = Instance.new("ScreenGui")
local ShiftLockButton = Instance.new("ImageButton")
local ShiftlockCursor = Instance.new("ImageLabel")

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Player = Players.LocalPlayer

local States = {
    Off = "rbxasset://textures/ui/mouseLock_off@2x.png",
    On = "rbxasset://textures/ui/mouseLock_on@2x.png",
    Lock = "rbxasset://textures/MouseLockedCursor.png"
}

local EnabledOffset = CFrame.new(1.7, 0, 0)
local Active
local PreviousMouseBehavior
local PreviousCameraType
local CameraYaw = 0
local CameraPitch = 0
local CameraDistance = 8
local CameraFocusOffset = Vector3.new(0, 1.5, 0)
local CameraSensitivity = 0.005

-- GUI Setup
ShiftLockScreenGui.Name = "ShiftLockGui"
ShiftLockScreenGui.Parent = CoreGui
ShiftLockScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ShiftLockScreenGui.ResetOnSpawn = false

ShiftLockButton.Parent = ShiftLockScreenGui
ShiftLockButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
ShiftLockButton.BackgroundTransparency = 1
ShiftLockButton.Position = UDim2.new(0.82, 0, 0.88, 0)
ShiftLockButton.Size = UDim2.new(0.05, 0, 0.05, 0)
ShiftLockButton.SizeConstraint = Enum.SizeConstraint.RelativeXX
ShiftLockButton.Image = States.Off

ShiftlockCursor.Name = "Shiftlock Cursor"
ShiftlockCursor.Parent = ShiftLockScreenGui
ShiftlockCursor.Image = States.Lock
ShiftlockCursor.Size = UDim2.new(0.03, 0, 0.03, 0)
ShiftlockCursor.Position = UDim2.new(0.5, 0, 0.5, 0)
ShiftlockCursor.AnchorPoint = Vector2.new(0.5, 0.5)
ShiftlockCursor.SizeConstraint = Enum.SizeConstraint.RelativeXX
ShiftlockCursor.BackgroundTransparency = 1
ShiftlockCursor.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
ShiftlockCursor.Visible = false

local function SetShiftLock(enabled)
    if enabled == (Active ~= nil) then
        return
    end

    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if enabled then
        if not humanoid then
            return
        end

        PreviousMouseBehavior = UserInputService.MouseBehavior
        humanoid.AutoRotate = false
        humanoid.CameraOffset = EnabledOffset.Position
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        ShiftLockButton.Image = States.On
        ShiftlockCursor.Visible = true

        local camera = workspace.CurrentCamera
        local focus = character:FindFirstChild("HumanoidRootPart")
        if camera and focus then
            PreviousCameraType = camera.CameraType
            camera.CameraType = Enum.CameraType.Scriptable
            local focusPosition = focus.Position + CameraFocusOffset
            local relative = camera.CFrame.Position - focusPosition
            CameraDistance = math.max(relative.Magnitude, 2)
            CameraYaw = math.atan2(-relative.X, -relative.Z)
            CameraPitch = math.asin(math.clamp(relative.Y / CameraDistance, -0.95, 0.95))
        end

        Active = true
        RunService:BindToRenderStep("ShiftLockCamera", Enum.RenderPriority.Camera.Value + 1, function()
            local currentCharacter = Player.Character
            local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
            local hrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
            local cam = workspace.CurrentCamera
            if not currentHumanoid or not hrp or not cam then
                return
            end

            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            currentHumanoid.AutoRotate = false
            currentHumanoid.CameraOffset = EnabledOffset.Position
            local delta = UserInputService:GetMouseDelta()
            CameraYaw = CameraYaw - delta.X * CameraSensitivity
            CameraPitch = math.clamp(CameraPitch + delta.Y * CameraSensitivity, -1.35, 1.35)

            local focusPosition = hrp.Position + CameraFocusOffset
            local horizontal = math.cos(CameraPitch) * CameraDistance
            local cameraPosition = focusPosition + Vector3.new(
                -math.sin(CameraYaw) * horizontal,
                math.sin(CameraPitch) * CameraDistance,
                -math.cos(CameraYaw) * horizontal
            )
            cam.CFrame = CFrame.lookAt(cameraPosition, focusPosition)

            local look = cam.CFrame.LookVector
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(look.X, 0, look.Z))
        end)
    else
        if humanoid then
            humanoid.AutoRotate = true
            humanoid.CameraOffset = Vector3.zero
        end

        RunService:UnbindFromRenderStep("ShiftLockCamera")
        Active = nil
        local camera = workspace.CurrentCamera
        if camera and PreviousCameraType then
            camera.CameraType = PreviousCameraType
        end
        PreviousCameraType = nil
        UserInputService.MouseBehavior = PreviousMouseBehavior or Enum.MouseBehavior.Default
        PreviousMouseBehavior = nil
        ShiftLockButton.Image = States.Off
        ShiftlockCursor.Visible = false
    end
end

ShiftLockButton.MouseButton1Click:Connect(function()
    SetShiftLock(Active == nil)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.LeftShift then
        SetShiftLock(Active == nil)
    end
end)

return SetShiftLock
